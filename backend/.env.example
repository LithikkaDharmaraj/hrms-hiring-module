# Database
DATABASE_URL=postgresql://postgres@localhost:5432/ai_interview_platform

# Auth (must match frontend NEXTAUTH_SECRET)
NEXTAUTH_SECRET=change-this-to-a-random-string

# Frontend URL (for generating interview links in emails)
FRONTEND_URL=http://localhost:3000

# Backend URL (for internal self-referential API calls)
BACKEND_URL=http://localhost:8000

# Internal service key
INTERNAL_SERVICE_KEY=ats-internal-key

# AI Model (any OpenAI-compatible endpoint)
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o

# TTS Provider: "deepgram" | "edge" | "elevenlabs" | "sarvam"
TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# ElevenLabs TTS (when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Edge TTS (when TTS_PROVIDER=edge)
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+10%

# Sarvam TTS/STT (when using sarvam providers)
SARVAM_API_KEY=

# STT Provider: "soniox" | "deepgram" | "sarvam"
STT_PROVIDER=soniox
SONIOX_API_KEY=
STT_LANGUAGE=en-IN

# Proctoring
MAX_PROCTORING_STRIKES=25
NEXT_PUBLIC_MAX_PROCTORING_STRIKES=25

# Email (optional - falls back to console logging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ATS API (ATSApi-main service)
ATS_API_URL=http://localhost:8000

# Task Evaluation API
TASK_EVAL_API_URL=http://localhost:9000

# Server port
PORT=8000

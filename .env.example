# AI Interview Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# Soniox (STT) - Get key at soniox.com
SONIOX_API_KEY=91d397fe09279b66bccc7dc33bd66fc5df074f922476252235c97b6b2dc9e93a

# Deepgram (TTS) - Get free key at console.deepgram.com
DEEPGRAM_API_KEY=

# AI Model (any OpenAI-compatible endpoint)
AI_BASE_URL=https://api.openai.com
AI_API_KEY=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
AI_MODEL=gpt-4o

# Database
DATABASE_URL=postgresql://postgres@localhost:5432/ai_interview_platform

# NextAuth
NEXTAUTH_SECRET=change-this-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# TTS Provider: "deepgram" (default) or "edge" (free Indian voices)
TTS_PROVIDER=deepgram
# Edge TTS settings (only when TTS_PROVIDER=edge)
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+10%

# Proctoring
NEXT_PUBLIC_MAX_PROCTORING_STRIKES=20

# Email (optional - falls back to console logging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ATS API (ATSApi-main service for resume pre-screening)
# Set to http://ats-api:8000 when running via Docker Compose
ATS_API_URL=http://localhost:8000

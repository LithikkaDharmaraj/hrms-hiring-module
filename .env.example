# AI Interview Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# Soniox (STT) - Get key at soniox.com
SONIOX_API_KEY=

# Deepgram (TTS) - Get free key at console.deepgram.com
DEEPGRAM_API_KEY=

# AI Model (any OpenAI-compatible endpoint)
AI_BASE_URL=https://api.groq.com/openai
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Database
DATABASE_URL=postgresql://lithikkadharmaraj@localhost:5432/ai_interview_platform

# NextAuth
NEXTAUTH_SECRET=ai-interview-platform-secret-key-2024
NEXTAUTH_URL=http://127.0.0.1:3000

# TTS Provider: "deepgram" (default) or "edge" (free Indian voices)
TTS_PROVIDER=openai
# OpenAI API key specifically for TTS (separate from AI_API_KEY used for the LLM)
OPENAI_API_KEY=

# Edge TTS settings (only when TTS_PROVIDER=edge)
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+10%

# Proctoring
NEXT_PUBLIC_MAX_PROCTORING_STRIKES=20

# Email (optional - falls back to console logging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ATS API (ATSApi-main service for resume pre-screening)
# Set to http://ats-api:8000 when running via Docker Compose
ATS_API_URL=http://localhost:8000
